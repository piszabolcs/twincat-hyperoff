<!-- Note: the primary, SDK/NuGet-free build is ..\..\build.ps1 (built-in csc.exe).
     This csproj is only an alternative MSBuild path (it needs the net48 targeting pack). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>VbsAutoOff</AssemblyName>
    <RootNamespace>VbsAutoOff</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Company>Pintér Szabolcs</Company>
    <Product>VBS Auto Off (TwinCAT)</Product>
    <StartupObject>VbsAutoOff.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
</Project>

